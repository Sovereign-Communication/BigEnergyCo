# BigEnergyCo local dev — copy to .env (never commit .env)
# Production secret lives only in Cloudflare: wrangler secret put GROQ_API_KEY (worker/)
GROQ_API_KEY=
# Jev. TypeSafe direct is the only Jev provider (plan D-13, P0.3(b)); there is
# no second provider to configure a key for.
TYPESAFE_API_KEY=

# Trigger.dev development (the dashboard's DEV secret key)
TRIGGER_SECRET_KEY=
